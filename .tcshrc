#! /bin/tcsh

if (-f /etc/cshrc) then
	source /etc/cshrc
endif

# * Aliases
alias cd 'cd \!*;set prompt="`hostname -s`:`dirs`> "'
alias qdell 'qselect -u $USER | xargs qdel'
alias qlload 'set ncols=`tput cols`; env COLUMNS=200 qload | fold -c"$ncols"'
alias code-physics '$HOME/code-physics/start-code-physics'
alias code-physics-2 '$HOME/code-physics/start-code-physics --workdir $HOME/code-physics/cli2/ --name code-physics-2'
alias config 'git --git-dir="$HOME/physics-cluster" --work-tree="$HOME" \!*'

limit coredumpsize 0
umask 022
set filec
setenv XAUTHORITY "$HOME/.Xauthority"

module load pbspro
module load gsl-2.7
module load hdf/5/1.14.1-2_intel2021

set autoexpand
set prompt="`hostname -s`:`dirs`> "

setenv WORKDIR "/taiji1/bhar9988"

setenv LD_LIBRARY_PATH ""
setenv LD_PRELOAD ""
setenv JULIA_NUM_THREADS "auto"
setenv JULIA_REVISE_POLL 1
setenv VSCODE_CLI_USE_FILE_KEYCHAIN 1
setenv TERM "xterm-256color"
setenv CONDA_DEFAULT_ENV "bhar9988"
setenv PATH $HOME/.local/bin/:$PATH
setenv R_LIBS_USER "$HOME/rpackages/"
setenv PATH $HOME/.juliaup/bin:$PATH
if(`hostname`:q =~ node*) then
	setenv JULIA_CONDAPKG_OFFLINE "yes"
	setenv ALLEN_NEUROPIXELS_OFFLINE "true"

	if (! $?MOST_RECENT_SOCKET) then
	else
		if ("$MOST_RECENT_SOCKET" == "")  then
		else
			tunnelrecentsocket
		endif
	endif
endif

if(`hostname`:q =~ headnode*) then
	setenv JULIA_NUM_THREADS "1"
endif

source $HOME/build/miniforge3/etc/profile.d/conda.csh > /dev/null
conda activate bhar9988

source "$HOME/.cargo/env.tcsh"

# >>> juliaup initialize >>>

# !! Contents within this block are managed by juliaup !!

set path = (/suphys/bhar9988/.juliaup/bin $path)

# <<< juliaup initialize <<<
