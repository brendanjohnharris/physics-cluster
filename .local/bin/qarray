#!/bin/bash

# qarray - Monitor PBS array job progress with completion estimates
# Usage: qarray [-u username]
# If no username provided, defaults to current user

USER_TO_CHECK="$USER"

# Parse command line arguments
while getopts "u:" opt; do
    case $opt in
        u)
            USER_TO_CHECK="$OPTARG"
            ;;
        \?)
            echo "Usage: qarray [-u username]" >&2
            exit 1
            ;;
    esac
done

# Function to draw a progress bar
draw_progress_bar() {
    local completed=$1
    local running=$2
    local total=$3
    local width=30
    local percent=0

    if [ "$total" -gt 0 ]; then
        percent=$((completed * 100 / total))
    fi

    # ANSI color codes
    local ORANGE='\033[38;5;214m'
    local GREEN='\033[0;32m'
    local RESET='\033[0m'

    # Unicode block characters for sub-character resolution
    local blocks=(" " "▁" "▂" "▃" "▄" "▅" "▆" "▇") # "█"
    local nblocks=${#blocks[@]}
    local max_index=$((nblocks - 1))

    # Calculate filled portions with nblocks resolution
    if [ "$total" -eq 0 ]; then
        filled_parts=0
        running_parts=0
    else
        filled_parts=$((width * nblocks * completed / total))
        running_parts=$((width * nblocks * running / total))
        # Ensure at least 1 part is shown if there are running jobs (never round to 0)
        if [ "$running" -gt 0 ] && [ "$running_parts" -eq 0 ]; then
            running_parts=1
        fi
    fi

    printf "["
    for ((i=0; i<width; i++)); do
        local pos_parts=$((i * nblocks))
        local next_pos_parts=$(((i + 1) * nblocks))

        # Check if this position contains any running parts
        if [ "$next_pos_parts" -gt "$filled_parts" ] && [ "$pos_parts" -lt "$((filled_parts + running_parts))" ]; then
            # This position overlaps with running parts - prioritize showing orange
            if [ "$pos_parts" -lt "$((filled_parts + running_parts - max_index))" ]; then
                # Full running block
                printf "${ORANGE}${blocks[$max_index]}${RESET}"
            else
                # Partial running block
                local partial=$((filled_parts + running_parts - pos_parts))
                printf "${ORANGE}${blocks[$partial]}${RESET}"
            fi
        elif [ "$pos_parts" -lt "$((filled_parts - max_index))" ]; then
            # Full completed block
            printf "${GREEN}${blocks[$max_index]}${RESET}"
        elif [ "$pos_parts" -lt "$filled_parts" ]; then
            # Partial completed block
            local partial=$((filled_parts - pos_parts))
            printf "${GREEN}${blocks[$partial]}${RESET}"
        else
            # This position is entirely after running parts (empty space)
            printf " "
        fi
    done
    printf "] %3d%% (%d/%d)" "$percent" "$completed" "$total"
}

# Function to format time duration
format_time() {
    local seconds=$1

    if [ "$seconds" -lt 60 ]; then
        echo "${seconds}s"
    elif [ "$seconds" -lt 3600 ]; then
        local mins=$((seconds / 60))
        local secs=$((seconds % 60))
        echo "${mins}m ${secs}s"
    elif [ "$seconds" -lt 86400 ]; then
        local hours=$((seconds / 3600))
        local mins=$(((seconds % 3600) / 60))
        echo "${hours}h ${mins}m"
    else
        local days=$((seconds / 86400))
        local hours=$(((seconds % 86400) / 3600))
        echo "${days}d ${hours}h"
    fi
}

# Function to calculate time since job started
get_elapsed_time() {
    local start_time=$1
    local current_time=$(date +%s)
    echo $((current_time - start_time))
}

# Function to parse PBS time format (HH:MM:SS or seconds)
parse_time_to_seconds() {
    local time_str=$1

    if [[ "$time_str" =~ ^[0-9]+$ ]]; then
        # Already in seconds
        echo "$time_str"
    elif [[ "$time_str" =~ ^([0-9]+):([0-9]+):([0-9]+)$ ]]; then
        # Format: HH:MM:SS
        # Remove leading zeros to avoid octal interpretation
        local hours=$((10#${BASH_REMATCH[1]}))
        local mins=$((10#${BASH_REMATCH[2]}))
        local secs=$((10#${BASH_REMATCH[3]}))
        echo $((hours * 3600 + mins * 60 + secs))
    else
        echo "0"
    fi
}

# Get all jobs for the user
# echo "Checking array jobs for user: $USER_TO_CHECK"
# echo ""

# Use qstat to get job information
QSTAT_OUTPUT=$(qstat -u "$USER_TO_CHECK" 2>/dev/null)

if [ $? -ne 0 ]; then
    echo "Error: Unable to query jobs for user $USER_TO_CHECK"
    exit 1
fi

# Check if user has any jobs
if [ -z "$QSTAT_OUTPUT" ] || ! echo "$QSTAT_OUTPUT" | grep -q "$USER_TO_CHECK"; then
    echo "No jobs found for user $USER_TO_CHECK"
    exit 0
fi

# Extract array jobs (jobs with [] in their ID or status B for job array)
# Skip header lines and look for jobs with [] or status B in column 10
ARRAY_JOBS=$(echo "$QSTAT_OUTPUT" | tail -n +6 | awk '$1 ~ /\[\]/ || $10 == "B" {print $1}' | sort -u)

if [ -z "$ARRAY_JOBS" ]; then
    echo "No array jobs found for user $USER_TO_CHECK"
    exit 0
fi

# Process each array job
for BASE_JOB_ID in $ARRAY_JOBS; do
    # Get detailed info for this array job
    QSTAT_DETAIL=$(qstat -t "$BASE_JOB_ID" 2>/dev/null)

    if [ -z "$QSTAT_DETAIL" ]; then
        continue
    fi

    # Extract base job ID without the [] suffix for pattern matching
    BASE_PATTERN=$(echo "$BASE_JOB_ID" | sed 's/\[\].*//')

    # Count statuses (X = finished/completed, R = running, Q = queued, H = held, B = job array parent)
    TOTAL=$(echo "$QSTAT_DETAIL" | grep -E "^${BASE_PATTERN}\[[0-9]+\]" | wc -l)
    COMPLETED=$(echo "$QSTAT_DETAIL" | grep -E "^${BASE_PATTERN}\[[0-9]+\]" | grep -c " X ")
    RUNNING=$(echo "$QSTAT_DETAIL" | grep -E "^${BASE_PATTERN}\[[0-9]+\]" | grep -c " R ")
    QUEUED=$(echo "$QSTAT_DETAIL" | grep -E "^${BASE_PATTERN}\[[0-9]+\]" | grep -c " Q ")
    HELD=$(echo "$QSTAT_DETAIL" | grep -E "^${BASE_PATTERN}\[[0-9]+\]" | grep -c " H ")

    # Get job name
    JOB_NAME=$(echo "$QSTAT_DETAIL" | grep -E "^${BASE_PATTERN}\[[0-9]+\]" | head -1 | awk '{print $2}')

    # Skip if no array elements found (just the parent job)
    if [ "$TOTAL" -eq 0 ]; then
        continue
    fi

    # Draw progress bar with job ID on same line
    printf "%-10s " "$BASE_JOB_ID"
    draw_progress_bar "$COMPLETED" "$RUNNING" "$TOTAL"
    # echo ""

    # Calculate ETA if we have completed jobs and running/queued jobs remain
    if [ "$COMPLETED" -gt 0 ] && [ "$((RUNNING + QUEUED))" -gt 0 ]; then
        # Get total CPU time used by completed jobs from qstat output
        TOTAL_TIME_SECONDS=0
        COMPLETED_COUNT=0

        while IFS= read -r line; do
            # Extract time use (format: HH:MM:SS)
            TIME_USE=$(echo "$line" | awk '{print $4}')
            if [ -n "$TIME_USE" ] && [ "$TIME_USE" != "0" ]; then
                TIME_SECS=$(parse_time_to_seconds "$TIME_USE")
                TOTAL_TIME_SECONDS=$((TOTAL_TIME_SECONDS + TIME_SECS))
                COMPLETED_COUNT=$((COMPLETED_COUNT + 1))
            fi
        done < <(echo "$QSTAT_DETAIL" | grep -E "^${BASE_PATTERN}\[[0-9]+\]" | grep " X ")

        if [ "$COMPLETED_COUNT" -gt 0 ] && [ "$TOTAL_TIME_SECONDS" -gt 0 ]; then
            # Average time per completed job
            AVG_TIME_PER_JOB=$((TOTAL_TIME_SECONDS / COMPLETED_COUNT))

            # Calculate remaining jobs (excluding currently running ones)
            REMAINING_JOBS=$((TOTAL - COMPLETED - RUNNING))

            # Estimate remaining time based on parallel execution
            if [ "$RUNNING" -gt 0 ]; then
                # Time for currently running jobs to complete
                TIME_FOR_RUNNING=$((AVG_TIME_PER_JOB))

                # After current batch completes, how many more jobs remain?
                if [ "$REMAINING_JOBS" -gt 0 ]; then
                    # Number of additional batches needed (rounded up)
                    ADDITIONAL_BATCHES=$(( (REMAINING_JOBS + RUNNING - 1) / RUNNING ))
                    TIME_FOR_QUEUED=$((ADDITIONAL_BATCHES * AVG_TIME_PER_JOB))
                    ESTIMATED_REMAINING=$((TIME_FOR_RUNNING + TIME_FOR_QUEUED))
                else
                    # Only running jobs remain
                    ESTIMATED_REMAINING=$TIME_FOR_RUNNING
                fi
            else
                # No running jobs, all remaining jobs are queued
                ESTIMATED_REMAINING=$((AVG_TIME_PER_JOB * REMAINING_JOBS))
            fi

            echo " | ETA: $(format_time "$ESTIMATED_REMAINING"), Avg: $(format_time "$AVG_TIME_PER_JOB")"
        fi
    fi

    # echo ""
done

# echo "Last updated: $(date '+%Y-%m-%d %H:%M:%S')"
