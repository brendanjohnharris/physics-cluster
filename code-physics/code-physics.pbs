#!/bin/bash
#PBS -j oe
#PBS -l mem=88GB
#PBS -l vmem=88GB
#PBS -l ncpus=16
#PBS -l walltime=23:00:00

set -o pipefail   # so $? reflects the tunnel's exit, not tee's

# ---- Default values --------------------------------------------------------
workdir="${workdir:-"$HOME/.vscode/cli/"}"
name="${name:-"code-physics"}"
queue="${queue:-"physics"}"
max_retries="${max_retries:-10}"

logdir="$HOME/code-physics"
logfile="$logdir/$name.log"
nodefile="$logdir/current_node"

mkdir -p "$logdir"          # make sure the log dir exists
mkdir -p "$workdir"

echo "workdir=${workdir}"
echo "name=${name}"
echo "queue=${queue}"
echo "max_retries=${max_retries}"

CURRENT_NODE=$(echo "$HOSTNAME" | cut -d '.' -f1)
{
    echo "VSCODE_CLI_USE_FILE_KEYCHAIN=${VSCODE_CLI_USE_FILE_KEYCHAIN}"
    echo "$CURRENT_NODE"
} >> "$nodefile"

source "$HOME/.jobtunnel.sh"

# ---- Helpers ---------------------------------------------------------------

# Kill any existing tunnel using this CLI data dir / name, but NOT ourselves.
kill_stale_tunnel() {
    # Match the tunnel command for this specific data dir to avoid nuking
    # other people's / other names' tunnels on a shared node.
    local pids
    pids=$(pgrep -u "$USER" -f "code tunnel.*--cli-data-dir $workdir" | grep -v "^$$\$")
    if [ -n "$pids" ]; then
        echo "Found stale tunnel process(es): $pids — terminating."
        # shellcheck disable=SC2086
        kill $pids 2>/dev/null
        sleep 3
        # Force-kill anything that ignored SIGTERM
        pids=$(pgrep -u "$USER" -f "code tunnel.*--cli-data-dir $workdir" | grep -v "^$$\$")
        if [ -n "$pids" ]; then
            echo "Stale process(es) still alive, sending SIGKILL: $pids"
            # shellcheck disable=SC2086
            kill -9 $pids 2>/dev/null
            sleep 1
        fi
    else
        echo "No stale tunnel processes found."
    fi
}

# Warn if a tunnel with this name already appears registered on another node.
warn_if_registered_elsewhere() {
    if [ -f "$nodefile" ]; then
        local last_node
        last_node=$(grep -E '^[a-zA-Z0-9_-]+$' "$nodefile" | tail -n1)
        if [ -n "$last_node" ] && [ "$last_node" != "$CURRENT_NODE" ] \
           && [ "$last_node" != "complete" ]; then
            echo "WARNING: tunnel '$name' was last active on '$last_node', " \
                 "now starting on '$CURRENT_NODE'. The old session may still " \
                 "hold the tunnel registration and cause a conflict."
        fi
    fi
}

# Clean up our own tunnel process if the job is killed / walltime hit.
cleanup() {
    echo "Caught termination signal — cleaning up tunnel."
    kill_stale_tunnel
    [ -n "${_jt_sshd:-}" ] && kill "$_jt_sshd" 2>/dev/null   # jobtunnel sshd
    rm -f "$HOME/.jobs/${PBS_JOBID}.port"                    # jobtunnel registry
}
trap cleanup EXIT INT TERM

# ---- Pre-flight ------------------------------------------------------------
warn_if_registered_elsewhere
kill_stale_tunnel

# ---- Retry loop ------------------------------------------------------------
for ((i=1; i<=max_retries; i++)); do
    echo "Attempt $i of $max_retries"
    echo "Attempt $i of $max_retries" >> "$logfile"

    # Clear stale processes before every attempt, not just the first, in case
    # a failed attempt left a wedged singleton behind.
    if [ "$i" -gt 1 ]; then
        kill_stale_tunnel
    fi

    code tunnel --accept-server-license-terms --verbose \
        --name "$name" --cli-data-dir "$workdir" < /dev/null \
        | tee -a "$logfile" "$HOME/.jobs/${PBS_JOBID}.log"
    exit_code=${PIPESTATUS[0]}

    if [ "$exit_code" -eq 0 ]; then
        echo "Tunnel started successfully on attempt $i"
        echo "complete" >> "$nodefile"
        trap - EXIT INT TERM    # don't run cleanup on a clean exit
        rm -f "$HOME/.jobs/${PBS_JOBID}.port"   # tidy jobtunnel registry
        exit 0
    else
        echo "Attempt $i failed with exit code $exit_code"
        if [ "$i" -lt "$max_retries" ]; then
            echo "Retrying in 5 seconds..."
            sleep 5
        fi
    fi
done

echo "Failed to start tunnel after $max_retries attempts"
echo "FAILED after $max_retries attempts" >> "$nodefile"
exit 1
