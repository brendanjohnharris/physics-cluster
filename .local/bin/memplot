#!/bin/bash

# ==============================================================================
# Live Memory Monitor Dashboard
#
# Description:
# This script provides a live, continuously updating dashboard of the top
# memory-consuming processes. It reads data from the log file generated by
# the 'process_memory_monitor' script.
#
# Usage: memplot [hostname]
# If hostname is provided, it will look for memonitor_<hostname>.csv
# If exact match isn't found, it will search for files containing the hostname
#
# It should be run in a separate terminal while the main monitoring script
# is running and generating logs.
# ==============================================================================

# --- Configuration ---
# The interval in seconds between each screen refresh.
REFRESH_INTERVAL=10
# The number of lines to look back in the log file to determine top processes.
# A larger number gives a more stable "top" list but is slightly slower.
LOOKBACK_LINES=1000
# Number of top processes to display.
N=22
# Define a fixed terminal width for a stable layout.
FIXED_WIDTH=140
# Time window in seconds for peak memory calculation (1hr = 3600 seconds).
PEAK_WINDOW_SECONDS=3600

# --- Function to find log file ---
find_log_file() {
    local hostname="$1"
    local log_dir="$HOME/.jobs"

    # If no hostname provided, use current hostname
    if [ -z "$hostname" ]; then
        hostname=$(hostname)
    fi

    # First try exact match
    local exact_file="${log_dir}/memonitor_${hostname}.csv"
    if [ -f "$exact_file" ]; then
        echo "$exact_file"
        return 0
    fi

    # If exact match not found, search for files containing the hostname
    local matching_files=()
    while IFS= read -r -d '' file; do
        local basename=$(basename "$file" .csv)
        local file_hostname=${basename#memonitor_}
        if [[ "$file_hostname" == *"$hostname"* ]]; then
            matching_files+=("$file")
        fi
    done < <(find "$log_dir" -name "memonitor_*.csv" -print0 2>/dev/null)

    # If we found matches, use the first one
    if [ ${#matching_files[@]} -gt 0 ]; then
        if [ ${#matching_files[@]} -gt 1 ]; then
            echo "Found multiple matching files for hostname '$hostname':" >&2
            for file in "${matching_files[@]}"; do
                echo "  $file" >&2
            done
            echo "Using: ${matching_files[0]}" >&2
        fi
        echo "${matching_files[0]}"
        return 0
    fi

    # No matches found
    echo "Error: No log file found for hostname '$hostname'" >&2
    echo "Available log files:" >&2
    find "$log_dir" -name "memonitor_*.csv" 2>/dev/null | while read -r file; do
        echo "  $file" >&2
    done
    return 1
}

# --- Parse command line arguments ---
HOSTNAME_ARG="$1"

# Find the appropriate log file
LOG_FILE=$(find_log_file "$HOSTNAME_ARG")
if [ $? -ne 0 ] || [ -z "$LOG_FILE" ]; then
    exit 1
fi

# Extract hostname from the log file path for display
DISPLAY_HOSTNAME=$(basename "$LOG_FILE" .csv)
DISPLAY_HOSTNAME=${DISPLAY_HOSTNAME#memonitor_}

echo "Using log file: $LOG_FILE"
echo "Monitoring hostname: $DISPLAY_HOSTNAME"

# --- Pre-flight Checks ---
if [ ! -f "${LOG_FILE}" ]; then
    echo "Error: Log file '${LOG_FILE}' not found."
    echo "Please ensure the process_memory_monitor script is running."
    exit 1
fi

# --- Get Total Memory from Log File ---
# We read the last entry in the log to get the total memory info.
last_log_entry=$(tail -n 1 "${LOG_FILE}")
if [ -z "$last_log_entry" ]; then
    echo "Error: Log file is empty. Waiting for data..."
    # A simple wait loop for the log file to be populated
    while [ -z "$last_log_entry" ]; do
        sleep 2
        last_log_entry=$(tail -n 1 "${LOG_FILE}")
    done
fi

# Extract total memory (field 2) from the log.
# Updated log format: timestamp,total_mem_kb,pid,ppid,user,mem_percent,mem_kb,vmem_kb,command
TOTAL_MEM_KB=$(echo "${last_log_entry}" | cut -d, -f2)

if [ -z "$TOTAL_MEM_KB" ] || [ "$TOTAL_MEM_KB" -eq 0 ]; then
    echo "Error: Could not parse total memory from the log file."
    echo "Log file format may be incorrect. Expected: timestamp,total_mem_kb,..."
    exit 1
fi

# Convert total memory to GB for all calculations. Use awk for precision.
# Prepending LC_NUMERIC=C ensures that '.' is used as the decimal separator,
# preventing issues on systems with different locale settings (e.g., using ',').
TOTAL_MEM_GB=$(LC_NUMERIC=C awk -v kb="$TOTAL_MEM_KB" 'BEGIN { printf "%.2f", kb / 1024 / 1024 }')

# --- Main Loop ---
# This function will run until the script is manually stopped (Ctrl+C).
# We wrap it in a function to ensure the trap is set correctly.
main() {
    # Set a trap to restore the cursor when the script is exited.
    trap 'rm -f "$PEAK_DATA_FILE" "$PEAK_VMEM_FILE"; tput cnorm; tput cup $(tput lines) 0; echo; exit' INT TERM

    # Create temporary files for peak usage data.
    PEAK_DATA_FILE=$(mktemp)
    PEAK_VMEM_FILE=$(mktemp)

    # --- Initial Static Draw ---
    clear
    tput civis # Hide cursor

    # Create the horizontal separator line based on the fixed width
    HR_LINE=$(printf '%*s' "$FIXED_WIDTH" | tr ' ' '-')

    echo "--- Live Memory Usage (Top ${N}) --- Press Ctrl+C to exit ---"
    echo "Monitoring Host: ${DISPLAY_HOSTNAME}"
    echo "Total System Memory: ${TOTAL_MEM_GB} GB"
    printf "%-8s | %-15s | %-10s | %-10s | %-10s | %-10s | %-10s | %-6s | %-*s|\n" "PID" "Command" "User" "VMem" "Peak VMem" "Memory" "Peak Mem" "% MEM" "$((FIXED_WIDTH - 105))" "Memory usage"
    echo "${HR_LINE}"

    # Reserve space for the table and footer
    for ((i=0; i<N+3; i++)); do echo; done

    while true; do
        # Use the fixed width for calculations.
        term_width=${FIXED_WIDTH}
        # Define the maximum width for the bar chart area.
        # We leave space for labels.
        max_bar_width=$((term_width - 105))
        # Ensure max_bar_width is not negative if terminal is too small
        if [ "$max_bar_width" -lt 10 ]; then
            max_bar_width=10
        fi

        # --- Data Processing ---
        # Get the most recent data from the log file.
        recent_data=$(tail -n "${LOOKBACK_LINES}" "${LOG_FILE}")

        # Calculate start time for peak window.
        start_time_peak=$(( $(date +%s) - PEAK_WINDOW_SECONDS ))

        # Use awk to find the peak memory for each process in the last hour.
        # Updated log format: timestamp,total_mem_kb,pid,ppid,user,mem_percent,mem_kb,vmem_kb,command
        # We check timestamp ($1), key on pid ($3), and find max of mem_kb ($7).
        awk -F, -v start="$start_time_peak" '$1 > start { key=$3; if ($7 > max[key]) max[key]=$7 } END { for (k in max) print k,max[k] }' "${LOG_FILE}" > "$PEAK_DATA_FILE"

        # Use awk to find the peak vmem for each process in the last hour.
        # We check timestamp ($1), key on pid ($3), and find max of vmem_kb ($8).
        awk -F, -v start="$start_time_peak" '$1 > start { key=$3; if ($8 > max[key]) max[key]=$8 } END { for (k in max) print k,max[k] }' "${LOG_FILE}" > "$PEAK_VMEM_FILE"

        # Find the top N unique processes by their latest memory usage.
        # Updated log format: timestamp,total_mem_kb,pid,ppid,user,mem_percent,mem_kb,vmem_kb,command
        # We use pid ($3) and command ($9) to identify unique processes.
        # We print mem_kb ($7), vmem_kb ($8), pid ($3), command ($9), and user ($5).
        top_processes=$(echo "${recent_data}" | tac | \
            awk -F, '!seen[$3,$9]++ {print $7, $8, $3, $9, $5}' | \
            sort -rn | head -n $N)

        # --- Drawing the Dashboard ---

        # --- Calculate and Draw Total Memory Usage Row ---
        local line_num=5 # Start drawing dynamic content from line 5 (0-indexed)
        tput cup $line_num 0 # Move cursor to the start of the TOTAL line

        # Get the latest timestamp from the log to identify the most recent batch of process data.
        latest_timestamp=$(echo "${recent_data}" | tail -n 1 | cut -d, -f1)

        # Sum the memory usage (field 7) and vmem usage (field 8) for all processes from the latest timestamp.
        if [ -n "$latest_timestamp" ]; then
            used_mem_kb=$(echo "${recent_data}" | awk -F, -v ts="$latest_timestamp" '$1 == ts {sum += $7} END {print int(sum)}')
            used_vmem_kb=$(echo "${recent_data}" | awk -F, -v ts="$latest_timestamp" '$1 == ts {sum += $8} END {print int(sum)}')
        else
            used_mem_kb=0
            used_vmem_kb=0
        fi

        used_mem_gb_display=$(LC_NUMERIC=C awk -v kb="$used_mem_kb" 'BEGIN { printf "%.2f GB", kb / 1024 / 1024 }')
        used_vmem_gb_display=$(LC_NUMERIC=C awk -v kb="$used_vmem_kb" 'BEGIN { printf "%.2f GB", kb / 1024 / 1024 }')
        used_mem_gb_calc=$(LC_NUMERIC=C awk -v kb="$used_mem_kb" 'BEGIN { printf "%.4f", kb / 1024 / 1024 }')

        used_mem_percent=$(LC_NUMERIC=C awk -v used="$used_mem_gb_calc" -v total="$TOTAL_MEM_GB" 'BEGIN { printf "%.1f%%", (used/total) * 100 }')

        bar_length=$(LC_NUMERIC=C awk -v used="$used_mem_gb_calc" -v total="$TOTAL_MEM_GB" -v width="$max_bar_width" 'BEGIN { printf "%d", (used/total) * width }')

        bar=""
        for ((i=0; i<bar_length; i++)); do bar+="■"; done

        # Print the formatted line with blue text for "TOTAL" and a blue bar (foreground color).
        printf "$(tput setaf 4)%-8s$(tput sgr0) | %-15s | %-10s | $(tput setaf 4)%-10s$(tput sgr0) | %-10s | $(tput setaf 4)%-10s$(tput sgr0) | %-10s | $(tput setaf 4)%-6s$(tput sgr0) | %s%s%s" "TOTAL" "" "" "${used_vmem_gb_display}" "" "${used_mem_gb_display}" "" "${used_mem_percent}" "$(tput setaf 4)" "${bar}" "$(tput sgr0)"
        tput el # Erase to end of line
        tput cup $line_num $((103 + max_bar_width)); printf "|"

        ((line_num++))

        # --- Draw Top N Processes ---
        if [ -z "$top_processes" ]; then
            : # Do nothing if no process data, total is already drawn
        else
            echo "${top_processes}" | while read -r mem_kb vmem_kb pid cmd user; do
                tput cup $line_num 0 # Move cursor to the start of the line
                mem_kb=${mem_kb%.*}
                vmem_kb=${vmem_kb%.*}
                if [ -z "$mem_kb" ]; then continue; fi

                peak_mem_kb=$(grep "^${pid} " "$PEAK_DATA_FILE" | awk '{print $2}')
                peak_mem_gb_display="N/A"
                if [ -n "$peak_mem_kb" ]; then
                    peak_mem_gb_display=$(LC_NUMERIC=C awk -v kb="$peak_mem_kb" 'BEGIN { printf "%.2f GB", kb / 1024 / 1024 }')
                fi

                peak_vmem_kb=$(grep "^${pid} " "$PEAK_VMEM_FILE" | awk '{print $2}')
                peak_vmem_gb_display="N/A"
                if [ -n "$peak_vmem_kb" ]; then
                    peak_vmem_gb_display=$(LC_NUMERIC=C awk -v kb="$peak_vmem_kb" 'BEGIN { printf "%.2f GB", kb / 1024 / 1024 }')
                fi

                mem_gb_display=$(LC_NUMERIC=C awk -v kb="$mem_kb" 'BEGIN { printf "%.2f GB", kb / 1024 / 1024 }')
                vmem_gb_display=$(LC_NUMERIC=C awk -v kb="$vmem_kb" 'BEGIN { printf "%.2f GB", kb / 1024 / 1024 }')
                mem_gb_calc=$(LC_NUMERIC=C awk -v kb="$mem_kb" 'BEGIN { printf "%.4f", kb / 1024 / 1024 }')

                mem_percent=$(LC_NUMERIC=C awk -v used="$mem_gb_calc" -v total="$TOTAL_MEM_GB" 'BEGIN { printf "%.1f%%", (used/total) * 100 }')

                # Calculate current memory bar length
                current_bar_length=$(LC_NUMERIC=C awk -v used="$mem_gb_calc" -v total="$TOTAL_MEM_GB" -v width="$max_bar_width" 'BEGIN { printf "%d", (used/total) * width }')

                # Calculate peak memory bar length
                peak_bar_length=0
                if [ -n "$peak_mem_kb" ] && [ "$peak_mem_kb" -gt 0 ]; then
                    peak_mem_gb_calc=$(LC_NUMERIC=C awk -v kb="$peak_mem_kb" 'BEGIN { printf "%.4f", kb / 1024 / 1024 }')
                    peak_bar_length=$(LC_NUMERIC=C awk -v used="$peak_mem_gb_calc" -v total="$TOTAL_MEM_GB" -v width="$max_bar_width" 'BEGIN { printf "%d", (used/total) * width }')
                    # Ensure peak is at least as long as current
                    if [ "$peak_bar_length" -lt "$current_bar_length" ]; then
                        peak_bar_length=$current_bar_length
                    fi
                fi

                # Build the dual-colored bar
                bar=""
                # Green portion (current usage)
                for ((i=0; i<current_bar_length; i++)); do bar+="■"; done
                # Yellow portion (peak usage beyond current)
                yellow_length=$((peak_bar_length - current_bar_length))
                if [ "$yellow_length" -gt 0 ]; then
                    bar+="$(tput setaf 3)"  # Yellow color
                    for ((i=0; i<yellow_length; i++)); do bar+="■"; done
                    bar+="$(tput sgr0)"  # Reset color
                fi

                # Print the line with colored memory columns
                printf "%-8s | %-15.15s | %-10s | %-10s | %-10s | $(tput setaf 2)%-10s$(tput sgr0) | $(tput setaf 3)%-10s$(tput sgr0) | %-6s | $(tput setaf 2)%s$(tput sgr0)" "${pid}" "${cmd}" "${user}" "${vmem_gb_display}" "${peak_vmem_gb_display}" "${mem_gb_display}" "${peak_mem_gb_display}" "${mem_percent}" "${bar}"
                tput el # Erase to end of line
                tput cup $line_num $((103 + max_bar_width)); printf "|"

                ((line_num++))
            done
        fi

        # --- Draw Footer ---
        tput cup $((6 + N)) 0; printf "%s\n" "${HR_LINE}"; tput el
        tput cup $((7 + N)) 0; echo "Last updated: $(date)"; tput el

        # Wait for the specified interval before refreshing.
        sleep "${REFRESH_INTERVAL}"
    done
}

# Run the main function.
main