#!/bin/bash
# INTERACTIVE WRAPPER (v6): Uses '&& exit' for a clean, automatic exit.

# --- Prerequisite Check ---
if ! command -v tmux &> /dev/null; then
    echo "❌ Error: tmux is not installed. Please install it."
    echo "   On Debian/Ubuntu: sudo apt-get install tmux"
    echo "   On macOS (Homebrew): brew install tmux"
    exit 1
fi

if ! command -v monitor &> /dev/null; then
    echo "❌ Error: The 'monitor' helper script is not found in your PATH."
    echo "   Please make sure the 'monitor' script is executable and located"
    echo "   in a directory like /usr/local/bin or ~/bin."
    exit 1
fi

# Define the name for our tmux session
SESSION="job_monitor_session"

# Clean up any old session
tmux kill-session -t "$SESSION" 2>/dev/null

# --- Create and Configure the tmux Session ---

# 1. Create a new, detached session with a standard shell.
tmux new-session -d -s "$SESSION"

# 2. Set up key bindings for silent, background job switching.
tmux bind-key -T root . run-shell -b "monitor next > /dev/null 2>&1"
tmux bind-key -T root , run-shell -b "monitor prev > /dev/null 2>&1"

# 3. Send the command to start the monitor.
#    The '&& exit' is the crucial fix: it forces the shell inside tmux
#    to close as soon as the 'monitor' command finishes.
tmux send-keys -t "$SESSION" "monitor && exit" C-m

# Clean up the key bindings and kill the session when this script exits.
# This acts as a final safety net.
trap "tmux unbind-key -T root . ; tmux unbind-key -T root , ; tmux kill-session -t '$SESSION' 2>/dev/null" EXIT

# --- Attach to the Session ---
echo "✅ Session started. Press '.' for next job, ',' for previous. Press 'q' to quit."
tmux attach-session -t "$SESSION"

echo "✅ Session finished."